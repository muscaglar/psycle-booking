<?xml version="1.0" encoding="utf-8"?>
<!--
  The "yoga" class-type pictogram of the home-screen widget: a mat, rolled at one end. It is the app's own mark
  (js/app.js CLASS_PICTOGRAMS.yoga; the iPhone widget draws the same numbers in
  PsyclePictogram.swift): a 24 grid, stroked, round caps and joins, never filled. One path per
  element of the web mark, in its order: a path keeps its own data, with every number written
  out; a circle is two half-turn arcs; a rounded rect is its sides and four quarter arcs.
  The stroke is 2.2 grid units, the web mark's weight at the 18px it is drawn at in a tile.
  White, so that the colour filter the widget sets (PsyncWidgetViews) IS the mark's colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 3 19 h 14"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 13.5 15.5 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 16.4 15.5 a 0.6 0.6 0 1 0 1.2 0 a 0.6 0.6 0 1 0 -1.2 0 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
