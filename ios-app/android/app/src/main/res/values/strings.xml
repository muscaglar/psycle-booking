<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Psync</string>
    <string name="title_activity_main">Psync</string>
    <string name="package_name">com.psyclefinder.app</string>
    <string name="custom_url_scheme">com.psyclefinder.app</string>

    <!-- The home-screen widget. Its name and description are what the launcher's widget picker
         shows. "Nothing booked" is ALL the empty state says - the same words with nothing
         booked, signed out, or before the app was ever opened: the widget never says who is
         signed in, or whether anyone is. -->
    <string name="widget_next_class_label">Next class</string>
    <string name="widget_next_class_description">Your next booked class: the time, the class and your seat.</string>
    <string name="widget_nothing_booked">Nothing booked</string>
    <!-- What a screen reader says for the whole card: "Next class: Today 18:30, RIDE 45, ...". -->
    <string name="widget_spoken_next">Next class: %1$s</string>

    <!-- The picker preview (layout/widget_next_class_preview.xml), Android 12+: sample words,
         never a real booking. -->
    <string name="widget_preview_day" translatable="false">Today</string>
    <string name="widget_preview_time" translatable="false">18:30</string>
    <string name="widget_preview_title" translatable="false">RIDE 45</string>
    <string name="widget_preview_seat" translatable="false">Bike 9</string>

    <!-- The class countdown: one silent notification that counts down to the next booked class,
         from 90 minutes before it. The channel's name and description are what Android's own
         notification settings show for it, beside "Class reminders" and "New dates" (those two
         are named by the bridge, in native-bridge.js). The channel's ID is "class-countdown"
         (PsyncCountdownNotifier.CHANNEL_ID) and must never change. -->
    <string name="countdown_channel_name">Class countdown</string>
    <string name="countdown_channel_description">A silent countdown to your next booked class, from 90 minutes before it starts.</string>
    <!-- ALL a locked phone shows when it hides private content: these words and the start time.
         Never the class, the place or the seat. -->
    <string name="countdown_public_title">Next class</string>
</resources>
