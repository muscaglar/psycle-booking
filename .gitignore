# Dependencies (reproducible from package-lock.json via npm install)
node_modules/

# macOS
.DS_Store

# CocoaPods (reproducible from Podfile.lock via pod install)
ios-app/ios/App/Pods/

# Local Claude Code settings (machine-specific)
.claude/settings.json
.claude/settings.local.json

# Browser-check output (screenshots, traces) written by local tooling
.playwright-mcp/

# (Xcode build output and the generated config.xml are already covered by
# ios-app/ios/.gitignore — iOS-specific ignores live there.)

# Scratch folder of tests/tools/appstore-shots.mjs (raw captures + compose pages)
tests/tools/.appstore-work/
