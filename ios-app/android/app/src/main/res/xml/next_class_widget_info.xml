<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget, as the launcher is told about it (the receiver's meta-data in
  AndroidManifest.xml names this file).

  Size: it arrives two cells by two (minWidth / minHeight are the classic 70 x cells - 30 for
  launchers before Android 12, targetCell* is the same thing said in cells from Android 12) and
  can be resized both ways; from about four cells wide PsyncWidgetPlan switches to the wide
  layout.

  Freshness: the app repaints it whenever bookings change (WidgetCenterPlugin) and whenever
  it starts, the provider arms one inexact alarm - for the minute after the shown class
  starts, or for midnight if that comes first - and updatePeriodMillis is the backstop:
  30 minutes, the shortest Android allows.

  initialLayout is shown until the provider has painted once - after a restart too, and on
  some phones that lasts until Psync is opened. So it makes NO claim: the card and the app's
  name (layout/widget_next_class_loading.xml says why it is not "Nothing booked").
  previewLayout (sample words) and description are read from Android 12; older pickers show the
  app icon. No configuration activity, no keyguard category: a home-screen widget only.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_next_class_description"
    android:initialLayout="@layout/widget_next_class_loading"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/widget_next_class_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
