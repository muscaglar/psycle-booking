{
  "appId": "com.psyclefinder.app",
  "appName": "Psync",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Preferences": {
      "group": "PsycleFinderSettings"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_psync",
      "iconColor": "#1B2130"
