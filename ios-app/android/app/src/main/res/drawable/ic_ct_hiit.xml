<?xml version="1.0" encoding="utf-8"?>
<!--
  The "hiit" class-type pictogram of the home-screen widget: a bolt. It is the app's own mark
  (js/app.js CLASS_PICTOGRAMS.hiit; the iPhone widget draws the same numbers in
  PsyclePictogram.swift): a 24 grid, stroked, round caps and joins, never filled. One path per
  element of the web mark, in its order: a path keeps its own data, with every number written
  out; a circle is two half-turn arcs; a rounded rect is its sides and four quarter arcs.
  The stroke is 2.2 grid units, the web mark's weight at the 18px it is drawn at in a tile.
  White, so that the colour filter the widget sets (PsyncWidgetViews) IS the mark's colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 13.5 3 L 6 13.5 h 5.5 L 10.5 21 L 18 10.5 h -5.5 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
