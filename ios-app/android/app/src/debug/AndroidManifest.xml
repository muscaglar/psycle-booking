<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Gradle merges this file into the main manifest for the debug build type
  and leaves it out of a release build, and the class it names lives in app/src/debug/java: a
  release APK or bundle contains neither.

  WidgetPreviewActivity draws the home-screen widget WITHOUT a launcher: it builds the same
  RemoteViews the provider builds (PsyncWidgetViews) and shows them with RemoteViews.apply(). It
  is how the widget's look is proved on CI's emulator, where nobody can long-press a home screen:

    adb shell am start -W -n com.psyclefinder.app/.WidgetPreviewActivity \
        -e sample two -e size wide -e night 1

  exported="true" is what lets adb start it - and android:permission is what keeps everything
  else out. The DEBUG build is also the one a person sideloads onto a real, signed-in phone
  (ios-app/ANDROID.md, "Try it with nothing installed"), and there an exported activity with no
  permission could be started by any app, with words of its choosing, under Psync's name. A
  caller must hold android.permission.DUMP: the adb shell does; an app a member installs cannot
  (its protection level is signature|privileged|development). androidx's ProfileInstaller
  guards its adb-only receiver the same way. The permission is NAMED here, not requested: this
  manifest has no uses-permission, and must not gain one.

  It reads nothing the app stores, writes nothing, sends nothing and sets no click: it turns
  the extras it is given into a picture, under a caption that says what it is.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".WidgetPreviewActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
