<?xml version="1.0" encoding="utf-8"?>
<!-- Graphite, the dark ground: css/theme.css [data-theme="graphite"]. Read values/colors.xml
     first. A night qualifier outranks an API level, so these win on every Android version. -->
<resources>
    <color name="psync_ground">#12161F</color>

    <!-- The mark's dark appearance: the inks of assets/psync-logo-dark.svg. -->
    <color name="psync_mark_upper">#FCFDFE</color>
    <color name="psync_mark_lower">#AAB3C1</color>

    <color name="psync_status_bar">#12161F</color>
    <color name="psync_navigation_bar">#12161F</color>

    <!-- The widget's neutral look on Graphite: see values/colors.xml. White on the tile stays. -->
    <color name="psync_widget_surface">#1B2130</color>
    <color name="psync_widget_ink">#EEF1F5</color>
    <color name="psync_widget_ink_2">#B7BFCC</color>
    <color name="psync_widget_tile">#68758D</color>
</resources>
