<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The application theme, as Capacitor generated it. Nothing visible wears it: the one
         activity has its own themes below. Its three colours are in values/colors.xml. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The ground behind the web view and under both system bars: Cloud by day, Graphite by
         night (values/colors.xml, values-night/colors.xml). DayNight matters twice: it picks the
         night resources, and it is what makes the web view report prefers-color-scheme: dark,
         which the web app's first paint (themeBoot) follows. -->
    <style name="AppTheme.Ground" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/psync_ground</item>
        <item name="android:statusBarColor">@color/psync_status_bar</item>
        <item name="android:navigationBarColor">@color/psync_navigation_bar</item>
    </style>

    <!-- The dark-glyph flags, where the API level has them: empty here (API 22),
         windowLightStatusBar in values-v23/, plus windowLightNavigationBar in values-v27/. -->
    <style name="AppTheme.SystemBars" parent="AppTheme.Ground" />

    <!-- KEEP THIS NAME. BridgeActivity.onCreate switches the activity to
         R.style.AppTheme_NoActionBar once the launch window has done its work; the Capacitor
         library ships a plain style under this name and the app's copy replaces it. -->
    <style name="AppTheme.NoActionBar" parent="AppTheme.SystemBars">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The launch window (AndroidManifest.xml gives it to MainActivity): the ground with the
         mark centred, and no image files. On Android 12+ these three become the system splash
         screen; below that, androidx core-splashscreen draws the same thing as the window
         background. There is no wordmark, unlike the iPhone launch image: a splash icon is a
         drawable, and a vector cannot set type in the app's own font. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/psync_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
