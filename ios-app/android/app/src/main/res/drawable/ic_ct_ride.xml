<?xml version="1.0" encoding="utf-8"?>
<!--
  The "ride" class-type pictogram of the home-screen widget: a bike. It is the app's own mark
  (js/app.js CLASS_PICTOGRAMS.ride; the iPhone widget draws the same numbers in
  PsyclePictogram.swift): a 24 grid, stroked, round caps and joins, never filled. One path per
  element of the web mark, in its order: a path keeps its own data, with every number written
  out; a circle is two half-turn arcs; a rounded rect is its sides and four quarter arcs.
  The stroke is 2.2 grid units, the web mark's weight at the 18px it is drawn at in a tile.
  White, so that the colour filter the widget sets (PsyncWidgetViews) IS the mark's colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 2 16.5 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 15 16.5 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 5.5 16.5 h 7 l -3 -7.5 h 6 l 3 7.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 12.5 16.5 l 3 -7.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 8 6.5 h 3.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M 15.5 9 l -0.8 -3 h 2.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
