{
  "name": "psycle-class-finder-ios",
  "version": "1.0.0",
  "description": "Psycle Class Finder — iOS app via Capacitor",
  "private": true,
  "scripts": {
    "postinstall": "node patch-plugins.js",
    "patch": "node patch-plugins.js",
    "patch:check": "node patch-plugins.js --check",
    "build": "node build.js",
    "sync:check": "node build.js --check",
    "sync": "node patch-plugins.js && node build.js && npx cap sync ios",
    "open": "npx cap open ios",
    "build:open": "npm run sync && npx cap open ios",
    "update-web": "node build.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@ebarooni/capacitor-calendar": "6.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
